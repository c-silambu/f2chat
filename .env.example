# ==============================================
# VibePulse - Environment Configuration Template
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
# If MONGODB_URI is left empty or unreachable, the server gracefully falls back to persistent in-memory mock mode.
MONGODB_URI=mongodb://localhost:27017/vibepulse
# If REDIS_URL is left empty or unreachable, the server automatically uses the high-performance In-Memory Matchmaker.
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=super_secret_vibepulse_jwt_key_change_in_production_32chars!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123_secure_vibepulse

# WebRTC STUN/TURN Configuration (Passed to Frontend)
VITE_SOCKET_URL=http://localhost:5000
VITE_STUN_SERVER=stun:stun.l.google.com:19302
# Optional TURN server settings (for restrictive NAT/symmetric firewalls)
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
